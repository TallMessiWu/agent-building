    "def print_run(batches: list[list[ExecutionResult]]) -> None:\n",
    "    \"\"\"按批次打印执行结果，清楚展示 DAG 的调度顺序。\"\"\"\n",
    "    print(f\"任务：{TASK}\\n\")\n",
    "    for index, batch in enumerate(batches, start=1):\n",
    "        ids = \", \".join(item.step_id for item in batch)\n",
    "        parallel_hint = \" （可并行）\" if len(batch) > 1 else \"\"\n",
    "        print(f\"=== 执行批次 {index}: {ids}{parallel_hint} ===\")\n",
    "        for item in batch:\n",
    "            print(f\"- {item.title}: {item.output}\")\n",
    "        print()"
   ]
